---
// 1. Import your data and components
import MainLayout from '../layouts/MainLayout.astro';
import Player from '../components/player/Player.astro';
import { resume } from '../util/resume.ts';
import { getLastItemInPath } from '../util/path.ts';

export async function getStaticPaths() {

  return resume.projects
  .filter(project => project.link.startsWith("/"))
  .map(project => {
    return {
      params: { slug: getLastItemInPath(project.link) },
      props: { project }
    };
  });
}

const { project } = Astro.props;
---
<MainLayout title={project.name}>
	<Player title={project.name} src={project.link} />
</MainLayout>