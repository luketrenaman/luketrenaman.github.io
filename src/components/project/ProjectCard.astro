---
const { project } = Astro.props;
import Card from '../Card.astro';
const verbBasedOnType = project.type === 'Game' ? 'play' : 'explore';
import { getLocalPathOrDefaultExternal } from '../../util/path.ts';
const path = getLocalPathOrDefaultExternal(project.link);
---
<div class="col-xl-3 col-lg-4 col-md-4 col-sm-6 col-xs-12 mb-4">
  <Card>
    {project.thumbnail && (
      <div>
        <a aria-label={`Click to ${verbBasedOnType} ${project.name}`} href={path}>
          <img alt={project.alt} class="w-full aspect-[315/230] object-cover bg-white" src={project.thumbnail} />
        </a>
      </div>
    )}
    <div class="py-3 px-2.5">
      <h3 class="mb-1">
        <a href={path} class="text-xl font-extrabold">{project.name}</a>
      </h3>
      <p class="mt-2">{project.description}</p>
    </div>
  </Card>
</div>
