---
const { project } = Astro.props;
import Card from '../Card.astro';
const verbBasedOnType = project.type === 'Game' ? 'play' : 'explore';
---
<div class="col-xl-3 col-lg-4 col-md-4 col-sm-6 col-xs-12 mb-4">
  <Card>
    {project.thumbnail && (
      <div>
        <a aria-label={`Click to ${verbBasedOnType} ${project.name}`} href={project.link}>
          <img loading="lazy" alt={project.alt} class="w-full aspect-[315/230] object-cover bg-white" src={project.thumbnail} />
        </a>
      </div>
    )}
    <div class="py-3 px-2.5">
      <h3 class="mb-1">
        <a href={project.link} class="text-xl font-extrabold">{project.name}</a>
        {project.repo && (
          <a href={project.repo}><i class="fa fa-github right-info float-right"></i></a>
        )}
      </h3>
      <p class="mt-2">{project.description}</p>
    </div>
  </Card>
</div>
