---
const { contest } = Astro.props;
import ContestAwards from './ContestAwards.astro';
import DateTag from '../DateTag.astro';
import Card from '../Card.astro';
---
<div class="col-xl-3 col-sm-6 mb-4">
  <Card>
    <div class="py-3 px-2.5">
      <h3 class="text-xl font-extrabold">
        {contest.name}
      </h3>
      <DateTag date={contest.start} />
      {contest.description && <p><i class="fa fa-map-marker-alt"></i>{contest.description}</p>}
      <ContestAwards awards={contest.awards} />
      {contest.link && <a href={contest.link.url}>{contest.link.name}</a>}
    </div>
  </Card>
</div>
