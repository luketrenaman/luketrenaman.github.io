---
const { course } = Astro.props;
import Card from '../Card.astro';
import DateTag from '../DateTag.astro';
---
<div class="col-xl-3 col-sm-6 mb-4">
  <Card>
    <div class="py-3 px-2.5">
      <h3 class="text-xl font-extrabold">
        {course.name}
      </h3>
      <p class="italic">
        {course.institution}
      </p>
      <DateTag date={course.start} />
    </div>
  </Card>
</div>
