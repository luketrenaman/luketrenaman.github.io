---
const { title } = Astro.props;
---
<div class="pb-4">
  <p 
    class="text-xl" 
    style="width: 104%; margin-left: -2%; border-bottom: 4px solid #CEF6C6; line-height: 0.1em; text-align: center;"
  >
    <span class="text-white bg-backgroundPrimary" style="padding: 0 10px;">
      <b>{title}</b>
    </span>
  </p>
</div>
