---
const { title = 'luketrenaman.com | luke trenaman but website' } = Astro.props;
import '../styles/global.css';
import '../styles/bootstrap-grid.min.css'
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="description" content="The website of Luke Trenaman" />
    <meta name="keywords" content="luke trenaman snake maze snakemaze" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />
    <link rel="author" href="https://github.com/luketrenaman" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
    <style>body{font-family: 'Inter', var(--font-sans);}</style>
  </head>
  <body class="min-h-screen relative bg-backgroundPrimary text-textPrimary">
    <slot />
  </body>
</html>
